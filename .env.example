# Alumni (Node.js) - reference environment variables
# Copy this file to `.env` and fill in the blank values.
#
# - Docker Compose reads `.env` automatically (POSTGRES_* and *_HOST_PORT below).
# - The Node process does not load `.env` itself. Outside Docker run:
#     node --env-file=.env server.js        (Node 20.6+)

# ---------- Application ----------
# Defaults to 80 and falls back to 3000 if unavailable. The Docker image uses 3000.
PORT=3000

# ---------- PostgreSQL (config/db.js) ----------
# If DB_HOST is empty the app runs without a database (in-memory / JSON storage).
# Inside Docker Compose the host is the service name: db
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---------- Docker Compose: postgres service ----------
# Use the same values as DB_USER / DB_PASSWORD / DB_NAME.
# If left empty, docker-compose.yml falls back to its built-in development defaults.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Ports published on the host
POSTGRES_HOST_PORT=5432
APP_HOST_PORT=3000
